{
  "name": "@miseflow/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "setup:local": "tsx --env-file-if-exists=../.env scripts/setup-local.ts",
    "token": "tsx --env-file-if-exists=../.env scripts/token.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@miseflow/shared": "*",
    "@supabase/supabase-js": "2.118.0",
    "hono": "^4.7.0",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "3.2.7"
  }
}
