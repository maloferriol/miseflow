# One env file per environment at the repo root (ADR 0012). APP_ENV picks it: unset or `test` reads
# `.env.test`, `prod` reads `.env.prod`. A run reads exactly one file. No values here.
#
# test = the local Supabase stack. `npm run setup:local` writes `.env.test` for you.
# prod = the hosted Supabase project with the real data. Write `.env.prod` by hand (README: Prod setup).

# Postgres for Drizzle and `npm run db:migrate`.
# test: the stack's DB_URL (`npx supabase status`). prod: the session pooler string (port 5432).
DATABASE_URL=

# Supabase API. The server derives the token issuer and JWKS URL from it. test and prod.
SUPABASE_URL=

# test only: the server-side tests sign in with it. Not in .env.prod.
SUPABASE_PUBLISHABLE_KEY=
# test only: `npm run setup:local` seeds the test user with it. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# The browser reads only VITE_-prefixed values. test and prod.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# test only: the single test user that `npm run setup:local` creates (goes away with #207).
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# The kitchen's IANA time zone (e.g. Europe/Paris) for Service times and Availability. Unset: the
# server's own time zone, with a warning on startup. test and prod.
KITCHEN_TIME_ZONE=
