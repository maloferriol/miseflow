# The names the app, the tests and drizzle-kit read from the repo root's git-ignored `.env`.
# No values here: `npm run setup:local` writes a local `.env` with the local stack's values and a
# random test user password. For a cloud project, see "Cloud setup" in the README.

# Postgres for Drizzle and `npm run db:migrate`. Local: the stack's DB_URL (`npx supabase status`).
# Cloud: the session pooler string (port 5432).
DATABASE_URL=

# Supabase API. The server derives the token issuer and JWKS URL from it.
SUPABASE_URL=
# Local only: the server-side tests sign in with it.
SUPABASE_PUBLISHABLE_KEY=
# Local only: `npm run setup:local` seeds the test user with it. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# The browser reads only VITE_-prefixed values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local only: the single test user that `npm run setup:local` creates.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
