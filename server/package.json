{
  "name": "@miseflow/server",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "setup:local": "tsx --env-file-if-exists=../.env scripts/setup-local.ts",
    "token": "tsx --env-file-if-exists=../.env scripts/token.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx --env-file-if-exists=../.env scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@miseflow/shared": "*",
    "@supabase/supabase-js": "2.118.0",
    "hono": "^4.7.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.12"
  }
}
