{
  "name": "miseflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run dev -w server",
    "dev:prod": "node --experimental-strip-types scripts/dev-prod.ts",
    "build": "npm run build -w shared && npm run build -w web && npm run build -w server",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w web",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "check": "node --experimental-strip-types scripts/check.ts",
    "dev:user": "node --experimental-strip-types scripts/dev-user.ts",
    "dev:stop": "node --experimental-strip-types scripts/dev-stop.ts",
    "token": "node --experimental-strip-types scripts/token.ts",
    "setup:local": "npm run setup:local -w server",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.ts test",
    "db:migrate:prod": "node --experimental-strip-types scripts/db-migrate.ts prod",
    "db:seed:prod": "APP_ENV=prod npm run seed -w server",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "typescript-eslint": "8.72.1"
  }
}
