# Local development values for the local Supabase stack (`npx supabase start`).
# Copy to `.env` (git-ignored): `cp .env.example .env`. None of these work against a cloud project.

# Direct Postgres connection of the local stack (Drizzle, drizzle-kit migrate).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Supabase API. The two keys are the CLI's fixed local-only keys (`npx supabase status`).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Server-side only (seeding the test user). Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# The browser reads only VITE_-prefixed values.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The single local test user, created by `npm run setup:local`. Local test values only.
TEST_USER_EMAIL=cook@miseflow.test
TEST_USER_PASSWORD=h4f90L51zM_ZpqJoGlJAcOlD
